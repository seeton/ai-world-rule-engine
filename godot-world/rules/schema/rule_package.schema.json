{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-world.local/rules/schema/rule_package.schema.json",
  "title": "Godot World Rule Package",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "display_name",
    "description",
    "version",
    "author",
    "source_repo",
    "source_ref",
    "package_dependencies",
    "tags",
    "match_phrases",
    "community",
    "patch"
  ],
  "properties": {
    "schema_version": {
      "const": "rule_package_v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "source_repo": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "forked_from": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "package_id",
        "source_repo",
        "source_ref"
      ],
      "properties": {
        "package_id": {
          "type": "string"
        },
        "source_repo": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "suggested_pr_target": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "repo",
        "base_ref",
        "package_id"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "package_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "match_phrases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community": {
      "type": "object",
      "required": [
        "likes",
        "dislikes",
        "alternative_package_ids"
      ],
      "properties": {
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "dislikes": {
          "type": "integer",
          "minimum": 0
        },
        "alternative_package_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": [
        "format",
        "review_status",
        "operations"
      ],
      "properties": {
        "format": {
          "const": "rule_patch_v1"
        },
        "review_status": {
          "enum": [
            "approved",
            "needs_design_review",
            "draft"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "upsert_stat",
                  "upsert_rule",
                  "add_event_binding",
                  "add_relation"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "package_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._-]+$"
      }
    },
    "runtime_contract": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "supports_world_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "two_d",
              "three_d"
            ]
          }
        },
        "foundation_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provides_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          }
        },
        "requires_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          }
        },
        "dependency_mode": {
          "type": "string",
          "enum": [
            "initial_default_provider",
            "hard_package_dependency",
            "optional"
          ]
        },
        "depends_on_package_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          }
        },
        "life_order_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "world_state_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "default_installed": {
              "type": "boolean"
            },
            "immutable_engine_invariant": {
              "type": "boolean"
            },
            "removable": {
              "type": "boolean"
            },
            "disableable": {
              "type": "boolean"
            },
            "replaceable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "collapse_behavior": {
          "type": "object",
          "properties": {
            "runtime_must_prevent_removal": {
              "type": "boolean"
            },
            "removal_may_degrade_world": {
              "type": "boolean"
            },
            "exposes_dependency_breakage_as": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "replacement_contract": {
          "type": "object",
          "properties": {
            "alternative_packages_may_provide_capabilities": {
              "type": "boolean"
            },
            "consumers_require_capabilities_not_package_ids": {
              "type": "boolean"
            },
            "requires_default_package_ids": {
              "type": "boolean"
            },
            "requires_capabilities_not_rule_ids": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "engine_safety_shell": {
          "type": "object",
          "properties": {
            "separate_from_world_rules": {
              "type": "boolean"
            },
            "responsibilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
