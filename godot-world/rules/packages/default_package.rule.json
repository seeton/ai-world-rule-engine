                "consumers_require_capabilities_not_package_ids": true
              },
              "engine_safety_shell": {
                "separate_from_world_rules": true,
                "responsibilities": [
                  "inspect",
                  "restore",
                  "report_dependency_breakage"
                ]
              }
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.existence",
        "rule_type": "runtime_rule",
        "player_description": "この世界にエンティティが存在し、IDや名前を持てるようにするルールです。",
