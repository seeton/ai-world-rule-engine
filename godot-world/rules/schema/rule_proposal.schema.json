{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-world.local/rules/schema/rule_proposal.schema.json",
  "title": "Codex Rule Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_title",
    "player_request_summary",
    "package_id",
    "package_schema_version",
    "patch",
    "touched_surfaces",
    "risk_notes",
    "validation",
    "review_status",
    "issue"
  ],
  "properties": {
    "schema_version": {
      "const": "codex_rule_proposal_v1"
    },
    "proposal_title": {
      "type": "string",
      "minLength": 1
    },
    "player_request_summary": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "package_schema_version": {
      "const": "rule_package_v1"
    },
    "suggested_pr_target": {
      "type": ["object", "null"],
      "required": ["repo", "base_ref", "package_id"],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": ["format", "operations"],
      "properties": {
        "format": {
          "const": "rule_patch_v1"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": {
                "enum": [
                  "upsert_stat",
                  "upsert_rule",
                  "add_event_binding",
                  "add_relation"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "touched_surfaces": {
      "type": "object",
      "required": ["stats", "rules", "event_bindings", "relations"],
      "properties": {
        "stats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "event_bindings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": {
          "enum": ["valid", "repairable", "needs_human_review", "rejected"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "severity", "message"],
            "properties": {
              "category": {
                "enum": ["schema", "semantic", "safety"]
              },
              "severity": {
                "enum": ["info", "warning", "error"]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "review_status": {
      "enum": ["needs_design_review", "repair_required", "rejected"]
    },
    "issue": {
      "type": "object",
      "required": ["title", "body_sections"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body_sections": {
          "type": "object",
          "required": ["summary", "proposal", "validation", "review"],
          "properties": {
            "summary": { "type": "string" },
            "proposal": { "type": "string" },
            "validation": { "type": "string" },
            "review": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
