              ],
              "supports_world_modes": [
                "two_d",
                "three_d"
              ],
              "proximity_model": "shared_position_graph"
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.base_time",
        "rule_type": "runtime_rule",
        "player_description": "世界と登場人物に共通の時間の流れを持たせる土台ルールです。",
        "name": "Base Time",
        "concept": "time",
        "scope": "entity",
        "target_tags": [
          "mortal"
        ],
        "requires_rule_kinds": [
          "world.foundation"
        ],
        "provides_rule_kinds": [
          "world.base-time",
          "default-package.base-time",
          "world-clock"
        ],
        "effects": [
          {
            "component": "time",
            "field": "elapsed_seconds",
            "op": "add",
            "default": 0.0,
            "value_per_second": 0.0,
            "min": 0.0
          }
        ],
        "install_actions": [
          {
            "op": "merge_world_state",
            "path": "world_contract.default_package.capabilities.base_time",
            "value": {
              "world_clock_field": "elapsed_seconds",
              "tick_field": "tick_index",
              "ordering": "deterministic"
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.movement",
        "rule_type": "runtime_rule",
        "player_description": "エンティティが空間の中を移動できるようにするルールです。",
        "name": "Movement",
        "concept": "movement",
        "scope": "world",
        "requires_rule_kinds": [
          "world.space",
          "world.base-time"
        ],
        "provides_rule_kinds": [
          "world.movement",
          "default-package.movement"
        ],
        "install_actions": [
          {
            "op": "merge_world_state",
            "path": "world_contract.default_package.capabilities.movement",
            "value": {
              "runtime_entrypoint": "WorldState.dispatch_input_event(input.move.intent) + WorldState.advance_tick",
              "movement_intent_event": "input.move.intent",
              "movement_state_path": "entities.*.components.input.movement_intent",
              "supported_axes": [
                "x",
                "y",
                "z"
              ],
              "supports_world_modes": [
                "two_d",
                "three_d"
              ]
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.basic_action",
        "rule_type": "runtime_rule",
        "player_description": "エンティティが行動を選び、その結果を残せるようにするルールです。",
        "name": "Basic Action",
        "concept": "action",
        "scope": "world",
        "requires_rule_kinds": [
          "world.existence",
          "world.state"
        ],
        "provides_rule_kinds": [
          "world.basic-action",
          "default-package.basic-action"
        ],
        "install_actions": [
          {
            "op": "merge_world_state",
            "path": "world_contract.default_package.capabilities.basic_action",
            "value": {
              "unit_fields": [
                "intent",
                "action",
                "result"
              ],
              "player_task_history_field": "player_task_history",
              "event_log_field": "event_log"
            }
