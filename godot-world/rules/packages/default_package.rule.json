                "status",
                "enabled",
                "inactive"
              ],
              "world_paths": [
                "preview_3d.enabled",
                "event_log"
              ]
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.space",
        "rule_type": "runtime_rule",
        "player_description": "エンティティが位置を持ち、2Dや3Dの空間に配置できるようにするルールです。",
        "name": "Space",
        "concept": "space",
        "scope": "world",
        "requires_rule_kinds": [
          "world.foundation"
        ],
        "provides_rule_kinds": [
          "world.space",
          "default-package.space"
