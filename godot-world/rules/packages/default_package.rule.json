{
  "schema_version": "rule_package_v1",
  "package_id": "builtin.default_package",
  "display_name": "Default Package",
  "description": "Defines the minimum mutable world assumptions shared by the 2D and 3D runtime: existence, representation, state, space, base time, movement, and basic actions.",
  "version": "1.0.0",
  "author": "Godot World Team",
  "source_repo": "github.com/godot-world/rule-library",
  "source_ref": "refs/heads/main",
  "package_dependencies": [],
  "forked_from": null,
  "suggested_pr_target": {
    "repo": "github.com/godot-world/rule-library",
    "base_ref": "main",
    "package_id": "builtin.default_package"
  },
  "tags": [
    "default-package",
    "foundation",
    "world",
    "existence",
    "space",
    "time",
    "movement",
    "action",
    "two_d",
    "three_d"
  ],
  "match_phrases": [
    "default package",
    "world foundation",
    "base world invariants",
    "2d 3d shared foundation",
    "existence representation state space time movement basic action"
