    "review_status": "approved",
    "operations": [
      {
        "op": "upsert_rule",
        "rule_id": "default_package.foundation",
        "rule_type": "runtime_rule",
        "player_description": "世界を成立させる土台ルールです。存在・表現・状態・空間・時間・移動・基本行動を使えるようにします。",
        "name": "Default Package Foundation",
        "concept": "world_foundation",
        "scope": "world",
        "provides_rule_kinds": [
          "world.foundation",
          "default-package.base"
        ],
        "install_actions": [
          {
            "op": "merge_world_state",
            "path": "world_contract.default_package",
            "value": {
              "package_id": "builtin.default_package",
              "supports_world_modes": [
                "two_d",
                "three_d"
              ],
              "foundation_capabilities": [
                "existence",
                "representation",
                "state",
                "space",
                "base-time",
                "movement",
                "basic-action"
              ],
              "description": "Worlds share identity, representation, state, spatial placement, ordered time, movement, and basic actions before higher-order life rules are added.",
              "contract_id": "world.foundation.v1",
              "provides_capabilities": [
                "world.foundation",
                "world.existence",
                "world.representation",
                "world.state",
                "world.space",
                "world.base-time",
                "world.movement",
                "world.basic-action"
              ],
              "lifecycle": {
                "default_installed": true,
                "immutable_engine_invariant": false,
                "removable": true,
                "disableable": true,
                "replaceable": true
              },
              "collapse_behavior": {
                "runtime_must_prevent_removal": false,
                "removal_may_degrade_world": true,
                "exposes_dependency_breakage_as": [
                  "missing_required_rule_kinds",
                  "unresolved_rule_ids",
                  "inactive_rules",
                  "blocked_rules"
                ]
              },
              "replacement_contract": {
