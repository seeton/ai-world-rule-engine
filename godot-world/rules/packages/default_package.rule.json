              ],
              "entity_paths": [
                "render_3d"
              ],
              "rule_paths": [
                "rule_tree"
              ]
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.state",
        "rule_type": "runtime_rule",
        "player_description": "エンティティや世界が状態や有効・無効を持てるようにするルールです。",
        "name": "State",
        "concept": "state",
        "scope": "world",
        "requires_rule_kinds": [
          "world.foundation"
        ],
        "provides_rule_kinds": [
          "world.state",
          "default-package.state"
        ],
        "install_actions": [
          {
            "op": "merge_world_state",
            "path": "world_contract.default_package.capabilities.state",
            "value": {
