        "concept": "existence",
        "scope": "world",
        "requires_rule_kinds": [
          "world.foundation"
        ],
        "provides_rule_kinds": [
          "world.existence",
          "default-package.existence"
        ],
        "install_actions": [
          {
            "op": "merge_world_state",
            "path": "world_contract.default_package.capabilities.existence",
            "value": {
              "entity_fields": [
                "id",
                "name",
                "archetype"
              ],
              "snapshot_paths": [
                "world_id",
                "world_name",
                "entities"
              ],
              "rule_tree_path": "installed_rules_by_id"
            }
          }
        ]
      },
      {
        "op": "upsert_rule",
        "rule_id": "default_package.representation",
        "rule_type": "runtime_rule",
        "player_description": "見えるものも内部状態も含めて、世界の要素を表現できるようにするルールです。",
