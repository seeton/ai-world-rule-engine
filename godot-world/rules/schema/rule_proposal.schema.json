{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-world.local/rules/schema/rule_proposal.schema.json",
  "title": "Codex Rule Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_title",
    "player_request_summary",
    "package_id",
    "package_schema_version",
    "suggested_pr_target",
    "patch",
    "touched_surfaces",
    "risk_notes",
    "validation",
    "review_status",
    "issue"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "codex_rule_proposal_v1"
    },
    "proposal_title": {
      "type": "string",
      "minLength": 1
    },
    "player_request_summary": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "package_schema_version": {
      "type": "string",
      "const": "rule_package_v1"
    },
    "suggested_pr_target": {
      "type": ["object", "null"],
      "required": ["repo", "base_ref", "package_id"],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": ["format", "operations"],
      "properties": {
        "format": {
          "type": "string",
          "const": "rule_patch_v1"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "op",
              "stat_id",
              "value_type",
              "default",
              "min",
              "max",
              "ui_group",
              "rule_id",
              "rule_type",
              "player_description",
              "event",
              "target_rule",
              "target_stat",
              "watch_stat",
              "delta",
              "delta_source_field",
              "delta_per_point",
              "interval_seconds",
              "environment_key",
              "clamp_to_stat_bounds",
              "binding_id",
              "relation_id",
              "source",
              "target",
              "design_prompt",
              "comparator",
              "value",
              "effects",
              "safety_notes"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "upsert_stat",
                  "upsert_rule",
                  "add_event_binding",
                  "add_relation"
                ]
              },
              "stat_id": { "type": ["string", "null"] },
              "value_type": { "type": ["string", "null"] },
              "default": { "type": ["number", "null"] },
              "min": { "type": ["number", "null"] },
              "max": { "type": ["number", "null"] },
              "ui_group": { "type": ["string", "null"] },
              "rule_id": { "type": ["string", "null"] },
              "rule_type": { "type": ["string", "null"] },
              "player_description": { "type": ["string", "null"] },
              "event": { "type": ["string", "null"] },
              "target_rule": { "type": ["string", "null"] },
              "target_stat": { "type": ["string", "null"] },
              "watch_stat": { "type": ["string", "null"] },
              "delta": { "type": ["number", "null"] },
              "delta_source_field": { "type": ["string", "null"] },
              "delta_per_point": { "type": ["number", "null"] },
              "interval_seconds": { "type": ["number", "null"] },
              "environment_key": { "type": ["string", "null"] },
              "clamp_to_stat_bounds": { "type": ["boolean", "null"] },
              "binding_id": { "type": ["string", "null"] },
              "relation_id": { "type": ["string", "null"] },
              "source": { "type": ["string", "null"] },
              "target": { "type": ["string", "null"] },
              "design_prompt": { "type": ["string", "null"] },
              "comparator": { "type": ["string", "null"] },
              "value": { "type": ["number", "string", "boolean", "null"] },
              "effects": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "required": ["effect_type", "tag", "value"],
                  "properties": {
                    "effect_type": { "type": "string" },
                    "tag": { "type": ["string", "null"] },
                    "value": { "type": ["number", "string", "boolean", "null"] }
                  },
                  "additionalProperties": false
                }
              },
              "safety_notes": {
                "type": ["array", "null"],
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "touched_surfaces": {
      "type": "object",
      "required": ["stats", "rules", "event_bindings", "relations"],
      "properties": {
        "stats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "event_bindings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["valid", "repairable", "needs_human_review", "rejected"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "severity", "message"],
            "properties": {
              "category": {
                "type": "string",
                "enum": ["schema", "semantic", "safety"]
              },
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "error"]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "review_status": {
      "type": "string",
      "enum": ["needs_design_review", "repair_required", "rejected"]
    },
    "issue": {
      "type": "object",
      "required": ["title", "body_sections"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body_sections": {
          "type": "object",
          "required": ["summary", "proposal", "validation", "review"],
          "properties": {
            "summary": { "type": "string" },
            "proposal": { "type": "string" },
            "validation": { "type": "string" },
            "review": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
