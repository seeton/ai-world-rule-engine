      "existence",
      "representation",
      "state",
      "space",
      "base-time",
      "movement",
      "basic-action"
    ],
    "world_state_paths": [
      "world_contract.default_package",
      "world_contract.default_package.capabilities",
      "world_contract.default_package.lifecycle",
      "elapsed_seconds",
      "tick_index",
      "preview_3d",
